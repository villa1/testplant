PAYLOAD_SECRET=change-me

# Local Postgres example:
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/payloadbmj
#
# Vercel + Supabase recommendation:
# use the Supabase Transaction Pooler connection string, not localhost.
# Example shape only:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/payloadbmj

# Local URLs:
# PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# NEXT_PUBLIC_SERVER_URL=http://localhost:3000
#
# Vercel URLs:
# PAYLOAD_PUBLIC_SERVER_URL=https://your-project.vercel.app
# NEXT_PUBLIC_SERVER_URL=https://your-project.vercel.app
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used by draft preview and manual cache invalidation
PREVIEW_SECRET=change-me-too

# Optional. These are only needed if the app later uses the Supabase JS client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe keys are required for checkout flows and some end-to-end tests
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_
